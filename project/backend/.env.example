# --- Server ---
PORT=4000
NODE_ENV=production

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# --- Database (Neon Postgres) ---
# Get this from your Neon project dashboard. Must include sslmode=require.
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/gkquiz?sslmode=require

# --- Redis (OPTIONAL — caching, matchmaking queue, Socket.IO adapter) ---
# Leave this unset/blank to run without Redis: the server starts normally
# and falls back to an in-memory implementation for caching, OTP storage,
# and the matchmaking queue. This works fine for a single instance, but
# state won't survive a restart and won't be shared if you scale to more
# than one instance. Set REDIS_URL at any time to enable real Redis —
# Render Redis, Upstash, or local `docker run -p 6379:6379 redis` all work.
# Use rediss:// instead of redis:// if your provider requires TLS.
REDIS_URL=
# How long cached questions/leaderboard reads stay fresh before re-hitting Postgres.
CACHE_QUESTIONS_TTL_SECONDS=60
CACHE_LEADERBOARD_TTL_SECONDS=30

# --- Auth ---
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- Mobile OTP login ---
# 'console' (default) just logs the OTP to the server console/logs — good
# enough for local dev and testing without any SMS credentials. Switch to
# 'twilio' or 'msg91' in production and fill in the matching block below.
SMS_PROVIDER=console
# Twilio (used when SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# MSG91 (used when SMS_PROVIDER=msg91) — popular for India-based SMS delivery
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# --- Google login ---
# OAuth 2.0 Client ID from https://console.cloud.google.com/apis/credentials
# (Web application type). Required only for POST /api/auth/google.
GOOGLE_CLIENT_ID=

# --- Cashfree payment gateway ---
# Get these from https://merchant.cashfree.com/merchants/pg/credentials
# (use the Sandbox tab's keys while CASHFREE_ENV=SANDBOX).
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# 'SANDBOX' for testing, 'PRODUCTION' to charge real cards/UPI.
CASHFREE_ENV=SANDBOX
CASHFREE_API_VERSION=2023-08-01
# HMAC secret used to verify POST /api/payments/webhook came from Cashfree.
# Falls back to CASHFREE_SECRET_KEY if unset, but a dedicated secret
# (configured alongside the webhook URL in the dashboard) is safer.
CASHFREE_WEBHOOK_SECRET=
# Where Cashfree's hosted checkout redirects the browser after payment.
# Only needed if the frontend uses hosted checkout rather than the
# Drop-in/mobile SDK.
CASHFREE_RETURN_URL=
# For reference only — the actual webhook URL is configured in the Cashfree
# dashboard, not read from here.
CASHFREE_NOTIFY_URL=https://your-backend.onrender.com/api/payments/webhook

# Flat fee (in CASHFREE ORDER currency units, e.g. rupees not paise) charged
# per matchmaking queue join.
MATCH_ENTRY_FEE_AMOUNT=10
MATCH_ENTRY_FEE_CURRENCY=INR

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# --- Logging ---
# morgan format: use "combined" in production, "dev" for local/readable logs.
# Leave unset to auto-pick based on NODE_ENV.
LOG_FORMAT=combined
# winston log level: error, warn, info, http, verbose, debug, silly.
# Must be "http" or lower-priority (http/verbose/debug/silly) for morgan's
# HTTP access logs to show up in combined.log. Leave unset to auto-pick
# ("http" in production, "debug" in development).
LOG_LEVEL=http

# --- Misc ---
# Max JSON body size accepted by express.json()
BODY_LIMIT=1mb
# How long (ms) to wait for in-flight requests to finish during graceful shutdown
# before force-exiting the process.
SHUTDOWN_TIMEOUT_MS=10000
